-- TASKIFYRA D1 schema (SQLite). Run: wrangler d1 execute taskifyra --file=schema.sql --remote
CREATE TABLE IF NOT EXISTS users(email TEXT PRIMARY KEY,name TEXT,phone TEXT UNIQUE,salt TEXT,hash TEXT,created_at INTEGER);
CREATE TABLE IF NOT EXISTS stores(id TEXT PRIMARY KEY,owner_email TEXT NOT NULL,slug TEXT UNIQUE NOT NULL,name TEXT,bio TEXT,logo_key TEXT,payout_method TEXT,payout_number TEXT,status TEXT DEFAULT 'live',created_at INTEGER);
CREATE TABLE IF NOT EXISTS products(id TEXT PRIMARY KEY,store_id TEXT,title TEXT,blurb TEXT,price_bdt INTEGER NOT NULL,r2_key TEXT,file_name TEXT,status TEXT DEFAULT 'live',created_at INTEGER);
CREATE TABLE IF NOT EXISTS orders(id TEXT PRIMARY KEY,okey TEXT,item TEXT,method TEXT,currency TEXT,amount REAL,trx TEXT,name TEXT,email TEXT,phone TEXT,status TEXT,created_at INTEGER,approved_at INTEGER,store_id TEXT,fee_bdt INTEGER DEFAULT 0);
CREATE TABLE IF NOT EXISTS reviews(id TEXT PRIMARY KEY,product_id TEXT,email TEXT,stars INTEGER,body TEXT,created_at INTEGER);
CREATE TABLE IF NOT EXISTS payouts(id TEXT PRIMARY KEY,store_id TEXT,amount_bdt INTEGER,status TEXT DEFAULT 'pending',created_at INTEGER,paid_at INTEGER);
CREATE INDEX IF NOT EXISTS o_email ON orders(email);CREATE INDEX IF NOT EXISTS o_st ON orders(status,approved_at);CREATE INDEX IF NOT EXISTS p_store ON products(store_id);

-- v9b (run once): ALTER TABLE stores ADD COLUMN banner_key TEXT; ALTER TABLE products ADD COLUMN cover_key TEXT;
CREATE TABLE IF NOT EXISTS views(store_id TEXT,day TEXT,n INTEGER DEFAULT 0,PRIMARY KEY(store_id,day));
