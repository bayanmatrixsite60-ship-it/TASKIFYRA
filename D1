const J=(o,s=200)=>new Response(JSON.stringify(o),{status:s,headers:{"Content-Type":"application/json","Cache-Control":"no-store"}});
const hx=b=>[...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,"0")).join("");
async function mac(env,m){if(!env.SESSION_SECRET)throw new Error("SESSION_SECRET missing");const k=await crypto.subtle.importKey("raw",new TextEncoder().encode(env.SESSION_SECRET),{name:"HMAC",hash:"SHA-256"},false,["sign"]);return hx(await crypto.subtle.sign("HMAC",k,new TextEncoder().encode(m)))}
const same=(a,b)=>a.length===b.length&&[...a].reduce((r,c,i)=>r|(c.charCodeAt(0)^b.charCodeAt(i)),0)===0;

// Call from createOrder() and approve()/reject(): never blocks the request if D1 fails.
export async function d1Order(env,o){if(!env.DB)return;try{await env.DB.prepare("INSERT OR REPLACE INTO orders(id,okey,item,method,currency,amount,trx,name,email,phone,status,created_at,approved_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)").bind(o.id,o.key,o.item,o.method,o.currency,o.amount,o.trx||"",o.customer.name,o.customer.email.toLowerCase(),o.customer.phone,o.status,o.at,o.approvedAt||0).run()}catch(e){console.log("d1Order",String(e.message||e))}}
export async function d1Stats(env){const q=(s,...b)=>env.DB.prepare(s).bind(...b).all().then(r=>r.results);const ok="status='approved'";
const [t]=await q(`SELECT COUNT(*) n,COALESCE(SUM(CASE WHEN currency='USD' THEN amount*120 ELSE amount END),0) v FROM orders WHERE ${ok}`);
const d=await q(`SELECT date((approved_at+21600000)/1000,'unixepoch') day,COUNT(*) n,SUM(CASE WHEN currency='USD' THEN amount*120 ELSE amount END) v FROM orders WHERE ${ok} GROUP BY day ORDER BY day DESC LIMIT 30`);
const [p]=await q("SELECT COUNT(*) n FROM orders WHERE status IN('pending','awaiting_card')");return{ok:true,orders:t.n,total:t.v,days:d,pending:p.n}}

// bKash Tokenized Checkout. Sandbox: BKASH_BASE=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout/
const bk=async(env,path,body,tok)=>(await fetch(env.BKASH_BASE+path,{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json",...(tok?{Authorization:tok,"X-APP-Key":env.BKASH_APP_KEY}:{username:env.BKASH_USER,password:env.BKASH_PASS})},body:JSON.stringify(body)})).json();
const grant=async env=>{const r=await bk(env,"token/grant",{app_key:env.BKASH_APP_KEY,app_secret:env.BKASH_APP_SECRET});if(!r.id_token)throw new Error("bKash auth failed");return r.id_token};
export async function bkashStart(env,o,origin){const tok=await grant(env);const r=await bk(env,"create",{mode:"0011",payerReference:o.customer.phone,callbackURL:origin+"/api/bkash/cb?oid="+o.id,amount:o.amount.toFixed(2),currency:"BDT",intent:"sale",merchantInvoiceNumber:o.id},tok);if(!r.bkashURL)throw new Error("bKash create failed");return r.bkashURL}
// Returns the order id only when bKash confirms Completed AND the amount matches. Then the worker calls approve(env,id).
export async function bkashDone(env,url,expectAmount){const pid=url.searchParams.get("paymentID");if(url.searchParams.get("status")!=="success"||!pid)return null;const tok=await grant(env);const r=await bk(env,"execute",{paymentID:pid},tok);return r.transactionStatus==="Completed"&&+r.amount===+expectAmount?url.searchParams.get("oid"):null}

